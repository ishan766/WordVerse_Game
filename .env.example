# Vite client: public URL of the separately hosted Arena server.
# Production currently uses https://wordverse-arena.onrender.com in .env.production.
VITE_ARENA_URL=http://localhost:3001

# Arena server. Set ARENA_ORIGINS to the exact allowed client origins.
# Render production: https://wordversegame.vercel.app,https://word-verse-game.vercel.app
ARENA_PORT=3001
ARENA_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
